# GEMINI_API_KEY: *** for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="***"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server
PORT=8090
NODE_ENV=development
CORS_ORIGIN=*
JWT_SECRET="development-only-jwt-secret-please-change"
ADMIN_EMAIL="admin@barber.local"
ADMIN_PASSWORD="ChangeMe123!"

# Optional SMTP for appointment cancellation verification codes
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
APPOINTMENT_CANCELLATION_CODE_TTL_MINUTES=10
APPOINTMENT_CANCELLATION_MAX_ATTEMPTS=5

# Data provider: sqlite | supabase
DATA_PROVIDER=sqlite
DB_PATH="./data/barber.sqlite"
SUPABASE_URL="https://zajenziflilxzakwakkb.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SCHEMA="public"

# Optional Google Sheets backup (sqlite mode only)
GOOGLE_SHEETS_BACKUP_ENABLED=true
GOOGLE_SHEETS_BACKUP_SHEET_ID="14LjCPsis2FRqlvObq7Z2WgapNIJy8-cPiAE5YpfCOMs"
GOOGLE_SHEETS_BACKUP_CREDENTIALS_PATH="/run/secrets/google-service-account.json"
GOOGLE_SHEETS_BACKUP_DEBOUNCE_MS=1200
